{
  "manifestVersion": 1,
  "id": "com.takumi.wdsimilar",
  "name": "WD Similar",
  "version": "0.2.0",
  "description": "Lists the images and videos whose WD Tagger tags are most like a chosen file's, in a window that stays open.",
  "apiVersion": 1,
  "run": { "command": "uv", "args": ["run", "--quiet", "main.py"] },
  "permissions": ["items.read", "content.read"],
  "commands": [
    { "id": "find", "title": "Find similar images", "progress": "never",
      "when": { "targets": "files",
                "extensions": ["png", "jpg", "jpeg", "webp", "bmp", "gif",
                               "mp4", "avi", "mkv", "webm", "mov", "wmv", "flv", "m4v"] } }
  ]
}
