{
  "name": "megaexplorer-slideshow",
  "productName": "Slideshow",
  "version": "0.1.0",
  "description": "Image slideshow plugin for MEGA Explorer",
  "author": "Takumi Yamada",
  "license": "MIT",
  "private": true,
  "main": "out/main/index.js",
  "scripts": {
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-vite build && electron-builder --dir",
    "package": "node scripts/package.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.8.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.58.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "build": {
    "appId": "com.takumi.slideshow",
    "productName": "Slideshow",
    "directories": {
      "output": "bin"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "dir"
    },
    "electronLanguages": [
      "en-US",
      "ja"
    ]
  }
}
