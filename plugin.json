{
  "manifestVersion": 1,
  "id": "com.takumi.wdtagger",
  "name": "WD Tagger",
  "version": "0.1.0",
  "apiVersion": 1,
  "run": { "command": "uv", "args": ["run", "--quiet", "main.py"] },
  "commands": [
    { "id": "tag-items", "title": "Tag selected", "progress": true, "result": "dialog",
      "when": { "targets": "files" } },
    { "id": "tag-folder", "title": "Tag all in folder", "progress": true, "result": "dialog",
      "when": { "targets": "folders" } },
    { "id": "retag-items", "title": "Retag selected", "progress": true, "result": "dialog",
      "when": { "targets": "files" } },
    { "id": "retag-folder", "title": "Retag all in folder", "progress": true, "result": "dialog",
      "when": { "targets": "folders" } }
  ]
}
